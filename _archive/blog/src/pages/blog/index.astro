---
import type { MarkdownInstance } from "astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FeaturedPost from "../../components/FeaturedPost.astro";
import BlogCard from "../../components/BlogCard.astro";
import Seo from "../../components/Seo.astro";
import { websiteSchema, breadcrumbSchema } from "../../lib/seo";
import "../../styles/global.css";

type Frontmatter = {
  title: string;
  description?: string;
  pubDate: string;
  author?: string;
  image?: string;
  tags?: string[];
};

const postModules = import.meta.glob<MarkdownInstance<Frontmatter>>(
  "../../posts/*.md",
  {
    eager: true,
  }
);

const posts = Object.entries(postModules)
  .map(([path, module]) => {
    const slug = path.split("/").pop()?.replace(/\.md$/, "") ?? "";
    const frontmatter = module.frontmatter;

    return {
      slug,
      data: {
        title: frontmatter.title ?? "Untitled Post",
        description: frontmatter.description ?? "",
        pubDate: frontmatter.pubDate ?? "",
        author: frontmatter.author ?? "Shidhartho Roy",
        image: frontmatter.image ?? "",
        tags: frontmatter.tags ?? [],
      },
    };
  })
  .filter((post) => post.slug !== "")
  .sort(
    (a, b) =>
      new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
  );

const featuredSlug = "cca-consensus-maps";

const featuredPost =
  posts.find((post) => post.slug === featuredSlug) ?? posts[0];

const remainingPosts = posts.filter((post) => post.slug !== featuredPost?.slug);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      title="Blog — Shidhartho Roy"
      description="Research updates, ongoing projects, and recommended reading from Shidhartho Roy."
      jsonLd={[
        websiteSchema(Astro.site),
        breadcrumbSchema([
          { name: "Home", path: "/" },
          { name: "Blog", path: "/blog/" },
        ], Astro.site),
      ]}
    />
    <script is:inline>
      (function () {
        document.documentElement.classList.add("js");
        try {
          var t = localStorage.getItem("theme");
          if (!t)
            t = window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
          document.documentElement.setAttribute("data-theme", t);
        } catch (e) {}
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Fraunces:ital,opsz,wght@1,9..144,400;1,9..144,500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />

    <main class="page">
      <div class="blog-intro">
        <h1 class="blog-title">Blog</h1>
        <p class="blog-lede">Research updates, ongoing work, and selected ideas worth sharing.</p>
      </div>

      {
        featuredPost ? (
          <FeaturedPost post={featuredPost} />
        ) : (
          <p class="blog-lede">No blog posts yet. Add a post in <code>src/posts/</code>.</p>
        )
      }

      {
        remainingPosts.length > 0 && (
          <div class="post-grid">
            {remainingPosts.map((post) => (
              <BlogCard post={post} />
            ))}
          </div>
        )
      }
    </main>

    <Footer />
  </body>
</html>
