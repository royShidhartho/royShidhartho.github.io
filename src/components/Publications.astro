---
import Materials from "./Materials.astro";
import { siteConfig } from "../config";
import { groupByCategory } from "../lib/publications";
import { boldAuthor } from "../lib/research";

const groups = groupByCategory(siteConfig.publications);
---

{
  groups.length > 0 && (
    <section id="publications" class="home-section">
      <h2 class="section-h">Publications</h2>
      {groups.map((group) => (
        <div class="pub-group">
          <h3 class="sub-h">{group.label}</h3>
          {group.years.map((yearGroup) => (
            <div class="pub-year">
              <h4 class="pub-year-h">{yearGroup.year}</h4>
              <ol class="pub-list">
                {yearGroup.items.map((pub) => (
                  <li>
                    <div class="pub-title">{pub.title}</div>
                    <div class="entry-cite">
                      <Fragment set:html={boldAuthor(pub.authors, siteConfig.authorName)} />
                    </div>
                    <div class="pub-venue">
                      <span>
                        <i>{pub.venue}</i>
                        {pub.details && `, ${pub.details}`}
                      </span>
                      <span class={`tag pub-type pub-type-${pub.type.toLowerCase()}`}>{pub.type}</span>
                      {pub.award && <span class="award">★ {pub.award}</span>}
                    </div>
                    <Materials item={pub} emptyNote={null} />
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
      ))}
      {siteConfig.social.scholar && (
        <a class="all-posts" href={siteConfig.social.scholar} target="_blank" rel="noopener noreferrer">
          Full list on Google Scholar <span aria-hidden="true">↗</span>
        </a>
      )}
    </section>
  )
}
